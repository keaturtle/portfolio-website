{
  "name": "@eighty/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure challenge engine for Eighty — no UI, no I/O",
  "main": "src/index.ts",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/*.test.ts"],
    "collectCoverageFrom": ["src/**/*.ts", "!src/index.ts", "!src/**/__tests__/**"],
    "coverageThreshold": {
      "global": { "branches": 100, "functions": 100, "lines": 100, "statements": 100 }
    }
  }
}
